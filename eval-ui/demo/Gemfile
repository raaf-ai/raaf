ruby ">= 3.3.0"

# Rails framework
gem "rails", "~> 7.0"

# Database
gem "pg", "~> 1.1"

# RAAF Eval UI engine (local path for development)
gem "raaf-eval", path: "../../eval"
gem "raaf-eval-ui", path: ".."

# Web server
gem "puma", "~> 6.0"

# Asset pipeline
gem "importmap-rails"
gem "stimulus-rails"
gem "tailwindcss-rails"
gem "turbo-rails"

# Background jobs
gem "sidekiq", "~> 7.0"

# Utilities
gem "bootsnap", require: false

